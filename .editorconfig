# Global .editorconfig file for .NET 9 / C# ecosystem

root = true

# All files - General formatting settings (Standard cross-platform rules)
[*]
indent_style = space
indent_size = 4
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

# C# Files - Strict Quality, Style, and Code Convention Rules
[*.cs]

#### 1. ASYNC / AWAIT GUIDELINES (Focus: Concurrency & SonarQube S6966 Rule) ####
# Forces the use of asynchronous methods and prevents unwanted synchronous thread blocking
dotnet_diagnostic.S6966.severity = error
csharp_style_allow_embedded_statements_on_same_line_development_only = false

#### 2. VAR KEYWORD PREFERENCES ####
# Forces the use of 'var' when the type is apparent from the right side (e.g., var result = new ResultSchema<T>())
dotnet_style_var_for_built_in_types = true:suggestion
dotnet_style_var_for_implicitly_typed_variables = true:suggestion
dotnet_style_var_when_type_is_apparent = true:error

#### 3. EXPRESSION-BODIED & SIMPLIFICATION PREFERENCES ####
# Requires curly braces for all conditional structures (if, else, for, while) even for single-line statements
csharp_style_expression_bodied_methods = false:none
csharp_style_expression_bodied_constructors = false:none
csharp_style_allow_blank_lines_between_consecutive_braces = false:suggestion

# Forces the use of modern .NET 9 pattern matching and syntax simplifications
csharp_style_prefer_switch_expression = true:suggestion
csharp_style_pattern_matching_over_as_with_null_check = true:error
csharp_style_pattern_matching_over_is_with_cast_check = true:error

#### 4. NAMING CONVENTIONS (PascalCase vs camelCase) ####
# Classes, Methods, Interfaces, and Properties must use PascalCase
dotnet_naming_rule.interfaces_should_be_pascal_case.severity = error
dotnet_naming_rule.interfaces_should_be_pascal_case.symbols = interface_symbols
dotnet_naming_rule.interfaces_should_be_pascal_case.style = pascal_case_with_i_prefix

dotnet_naming_symbols.interface_symbols.applicable_kinds = interface
dotnet_naming_style.pascal_case_with_i_prefix.required_prefix = I
dotnet_naming_style.pascal_case_with_i_prefix.capitalization = pascal_case

# Private fields must start with an underscore '_' and use camelCase (e.g., _userRepository)
dotnet_naming_rule.private_fields_should_start_with_underscore.severity = error
dotnet_naming_rule.private_fields_should_start_with_underscore.symbols = private_field_symbols
dotnet_naming_rule.private_fields_should_start_with_underscore.style = camel_case_with_underscore_prefix

dotnet_naming_symbols.private_field_symbols.applicable_kinds = field
dotnet_naming_symbols.private_field_symbols.applicable_accessibilities = private
dotnet_naming_style.camel_case_with_underscore_prefix.required_prefix = _
dotnet_naming_style.camel_case_with_underscore_prefix.capitalization = camel_case

#### 5. ORGANIZE USINGS ####
# Places 'System' directives at the top and removes unused usings
dotnet_sort_system_directives_first = true:suggestion
dotnet_style_coalesce_expression = true:suggestion
dotnet_style_null_propagation = true:suggestion

#### 6. SECURITY AND NULLABILITY PREFERENCES ####
# Enables strict null reference checks to mitigate NullReferenceException
dotnet_diagnostic.CA1062.severity = error
