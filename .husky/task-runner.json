{
  "$schema": "https://github.io",
  "tasks": [
    {
      "args": ["format", "--verify-no-changes", "--severity", "info"],
      "command": "dotnet",
      "group": "pre-commit",
      "name": "Dotnet Format Guard"
    },
    {
      "args": ["build", "--configuration", "Release", "--no-incremental"],
      "command": "dotnet",
      "group": "pre-commit",
      "name": "Dotnet Full Compilation Shield"
    },
    {
      "args": ["test", "--configuration", "Release"],
      "command": "dotnet",
      "group": "pre-commit",
      "name": "Dotnet Test Matrix"
    }
  ]
}
